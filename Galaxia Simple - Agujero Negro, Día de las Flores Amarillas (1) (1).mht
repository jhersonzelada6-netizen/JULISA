@charset "utf-8";

* { box-sizing: border-box; }

html, body { margin: 0px; height: 100%; background: rgb(0, 0, 0); overflow: hidden; user-select: none; -webkit-tap-highlight-color: transparent; }

canvas { display: block; }

#main-title { position: fixed; top: 40px; left: 0px; right: 0px; width: 100%; font-size: 2.6em; color: rgb(255, 250, 205); white-space: nowrap; text-shadow: rgb(255, 215, 0) 0px 0px 10px, rgb(255, 165, 0) 0px 0px 18px; z-index: 10; pointer-events: none; text-align: center; font-family: "Indie Flower", "Bradley Hand", "Segoe Script", cursive; }

@media (max-width: 768px) {
  #main-title { font-size: 1.55em; top: 22px; white-space: normal; padding: 0px 10px; line-height: 1.15; }
}

#start-screen { position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgb(0, 0, 0); display: flex; justify-content: center; align-items: center; flex-direction: column; color: rgb(255, 255, 255); z-index: 9999; padding: 20px; cursor: pointer; transition: opacity 0.7s, visibility 0.7s; }

#start-screen.hidden { opacity: 0; visibility: hidden; pointer-events: none; }

#start-heart { font-size: clamp(74px, 23vmin, 148px); line-height: 1; display: block; filter: drop-shadow(rgba(255, 215, 0, 0.75) 0px 0px 14px) drop-shadow(rgba(255, 165, 0, 0.38) 0px 0px 36px) drop-shadow(rgba(218, 165, 32, 0.22) 0px 0px 66px); animation: 1.35s ease-in-out 0s infinite normal none running latido; transform-origin: 50% 55%; }

@keyframes latido { 
  0%, 100% { transform: scale(1); }
  12% { transform: scale(1.15); }
  24% { transform: scale(1); }
  36% { transform: scale(1.07); }
  50% { transform: scale(1); }
}

#start-text { font-size: 1.8em; color: rgb(255, 250, 205); font-family: "Indie Flower", "Bradley Hand", "Segoe Script", cursive; text-shadow: rgb(255, 215, 0) 0px 0px 7px; text-align: center; margin-top: clamp(16px, 3.5vh, 28px); animation: 2.2s ease-in-out 0s infinite normal none running parpadeo; }

@keyframes parpadeo { 
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  #start-heart, #start-text { animation: auto ease 0s 1 normal none running none; }
}
